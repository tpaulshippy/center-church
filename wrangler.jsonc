{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "center-church",
  "main": "./worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "centergilbert.tpaulshippy.com/*",
      "zone_name": "tpaulshippy.com"
    }
  ]
}

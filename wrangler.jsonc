{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "center-church",
  "main": "./worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // Live domains (apex + www) are attached as Worker Custom Domains in the
  // church Cloudflare account dashboard, so no routes block is needed here.
  "routes": [],
  // Staging previews (personal Cloudflare account): every PR to main deploys
  // here via .github/workflows/staging.yml, served on
  // centergilbert.tpaulshippy.com. Never point this env at the church account.
  "env": {
    "staging": {
      "name": "center-church-staging",
      "routes": [
        { "pattern": "centergilbert.tpaulshippy.com/*", "zone_name": "tpaulshippy.com" }
      ]
    }
  }
}

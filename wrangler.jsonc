{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "center-church",
  "main": "./worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // Live domains (apex + www) are attached as Worker Custom Domains in the
  // church Cloudflare account dashboard, so no routes block is needed here.
  "routes": []
}
